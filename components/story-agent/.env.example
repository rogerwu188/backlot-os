# claude_story_agent — environment (COPY to .env; never commit real secrets)
# The code NEVER writes, logs, or returns a real key. Only presence is checked.

# --- Model backend selection: anthropic | command | mock | auto ---
CLAUDE_STORY_MODE=auto

# --- Anthropic backend (optional) ---
# ANTHROPIC_API_KEY=            # leave blank here; set only in your real .env / secret store
# Exact provider model ID for a deployed Claude 4.8-or-newer model.
# CLAUDE_STORY_ANTHROPIC_MODEL=your-claude-4-8-or-newer-model-id
CLAUDE_STORY_MIN_MODEL_VERSION=4.8
# Required when the provider model ID does not encode 4.8+ in its name.
# CLAUDE_STORY_MODEL_VERSION=4.8

# --- External command backend (optional) ---
# An executable plus arguments that reads {"system","user"} JSON on stdin and writes model text on stdout. It is executed directly, without a shell.
# CLAUDE_STORY_COMMAND=my-llm-cli --json

# --- Runtime ---
CLAUDE_STORY_WORKERS=4
# BACKLOT_STORY_LEDGER=/private/runtime/story-ledger.ndjson
