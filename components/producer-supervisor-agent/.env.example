# backlotos_producer_supervisor -- environment (COPY to .env; never commit real secrets)
# The code NEVER writes, logs, or returns a real key/token value.

# --- Worker pool ---
BACKLOT_PRODUCER_WORKERS=4

# --- Downstream agent invocation (AgentInvoker: http | command | mock | auto) ---
BACKLOT_INVOKER_MODE=auto

# Per-target-agent command backend (argv split with shlex, executed WITHOUT a
# shell, one JSON request on stdin -> one JSON object on stdout). Set one
# COMMAND or URL per agent this Producer needs to reach.
# BACKLOT_AGENT_STORY_COMMAND=claude-story-agent generate
# BACKLOT_AGENT_PIPELINE_COMMAND=backlotos-pipeline-command
# BACKLOT_AGENT_POST_COMMAND=
# BACKLOT_AGENT_REVIEW_COMMAND=

# Per-target-agent HTTP backend (POST {url} with the payload; requires the
# five-agent docker-compose deployment to be running).
# BACKLOT_AGENT_STORY_URL=http://story-agent:8802/v1/task
# BACKLOT_AGENT_PIPELINE_URL=http://pipeline-agent:8803/v1/task
# BACKLOT_AGENT_POST_URL=http://post-agent:8804/v1/task
# BACKLOT_AGENT_REVIEW_URL=http://review-agent:8805/v1/task

# --- Bearer token for the /v1/task HTTP surface (shared with agent_host.py) ---
BACKLOT_AGENT_TOKEN=

# --- Generic pipeline-tools gate wrapper location (for backlotos-pipeline-command) ---
# Defaults to the sibling components/pipeline-tools directory if unset.
# BACKLOT_PIPELINE_TOOLS_DIR=/path/to/components/pipeline-tools

# --- Wiring into the launcher's external-command adapters (deploy/five-agent/.env) ---
# BACKLOT_PRODUCER_COMMAND=backlotos-producer-command
# BACKLOT_PIPELINE_COMMAND=backlotos-pipeline-command
