{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "qingshan.episode-runtime-contract.v2.schema.json",
  "title": "Qingshan episode runtime and editorial budget contract",
  "type": "object",
  "required": ["schema", "episode", "version", "runtime_policy", "duration_budget"],
  "properties": {
    "schema": {"const": "qingshan.episode_runtime_contract.v2"},
    "episode": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "runtime_policy": {
      "type": "object",
      "required": ["version", "target_seconds", "soft_tolerance_seconds", "hard_tolerance_seconds"],
      "properties": {
        "version": {"const": "qingshan.episode-runtime.v2.0.0"},
        "target_seconds": {"type": "number", "exclusiveMinimum": 0},
        "soft_tolerance_seconds": {"type": "number", "minimum": 0},
        "hard_tolerance_seconds": {"type": "number", "minimum": 0}
      }
    },
    "duration_budget": {
      "type": "object",
      "required": ["hook_seconds", "action_seconds", "dialogue_seconds", "reaction_seconds", "transition_seconds", "ending_hook_seconds"],
      "additionalProperties": {"type": "number", "minimum": 0}
    },
    "estimated_runtime_seconds": {"type": "number", "minimum": 0},
    "dialogue_character_count": {"type": "integer", "minimum": 0},
    "dialogue_lines": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["dialogue_id", "function", "priority", "compressible"],
        "properties": {
          "dialogue_id": {"type": "string"},
          "function": {"enum": ["REVEAL", "DECISION", "CONFLICT", "REACTION", "SUPPORT", "REPEAT", "ATMOSPHERE"]},
          "priority": {"enum": ["CORE", "SUPPORT", "REPEAT", "ATMOSPHERE"]},
          "fact_ids": {"type": "array", "items": {"type": "string"}},
          "compressible": {"type": "boolean"}
        }
      }
    }
  }
}
