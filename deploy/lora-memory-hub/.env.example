BACKLOTOS_LORA_S3_BUCKET=replace-with-private-shared-bucket
BACKLOTOS_LORA_S3_PREFIX=backlotos-lora-memory
# Optional for S3-compatible stores such as R2, MinIO, or ArkFS.
BACKLOTOS_LORA_S3_ENDPOINT=
BACKLOTOS_LORA_COLLECTOR_TOKEN=replace-with-a-long-random-node-upload-token
BACKLOTOS_LORA_GITHUB_TOKEN=replace-with-central-service-only-github-token
BACKLOTOS_LORA_GITHUB_REMOTE=https://github.com/rogerwu188/backlot-os.git
BACKLOTOS_LORA_GITHUB_CHECKOUT=/data/backlot-os
BACKLOTOS_LORA_CONVERGE_INTERVAL_SECONDS=900
AWS_REGION=us-west-2
AWS_ACCESS_KEY_ID=replace-with-hub-service-aws-key
AWS_SECRET_ACCESS_KEY=replace-with-hub-service-aws-secret
